# Production Environment Configuration for iDenTFy Backend
PROJECT_NAME="iDenTFy AI Identity & Document Screening System"
ENV="production"
DEBUG=false

# PostgreSQL Database Connection String (Required)
# Render Managed Postgres provides this automatically as DATABASE_URL
DATABASE_URL="postgresql://identfy_user:identfy_password@localhost:5432/identfy_db"

# Production Frontend URL for CORS (Comma-separated for multiple origins)
FRONTEND_URL="https://identfy-frontend.onrender.com"

# Verification & Screening Flags
DATABASE_MATCHING_ENABLED=false
BYPASS_DATABASE_MATCHING=true
FACE_SIMILARITY_THRESHOLD=0.68
