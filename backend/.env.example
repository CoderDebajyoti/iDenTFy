# Environment Configuration for iDenTFy Backend
PROJECT_NAME="iDenTFy AI Identity & Document Screening System"
ENV="development"
DEBUG=true

# Database: PostgreSQL with SQLite fallback for local testability
DATABASE_URL="sqlite:///./database/identfy.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://identfy_user:identfy_password@localhost:5432/identfy"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# Face Biometrics
FACE_SIMILARITY_THRESHOLD=0.68

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://127.0.0.1:5173", "http://127.0.0.1:5174"]
